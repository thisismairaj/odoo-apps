<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mrj.meta.leads</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="convert_visitor_setting_container" position="inside">
                <setting id="mrj_meta_leads_setting" string="Facebook and Instagram Lead Ads"
                         help="Import leads from your Meta Lead Ads forms every 15 minutes, or at once by webhook."
                         groups="base.group_system">
                    <div class="row mt-2">
                        <label for="mrj_meta_page_id" class="col-lg-4 o_light_label"/>
                        <field name="mrj_meta_page_id" class="col-lg-8"/>
                    </div>
                    <div class="row mt-2">
                        <label for="mrj_meta_token" class="col-lg-4 o_light_label"/>
                        <field name="mrj_meta_token" password="True" class="col-lg-8"
                               placeholder="Long-lived Page access token with leads_retrieval"/>
                    </div>
                    <div class="row mt-2">
                        <label for="mrj_meta_days_back" class="col-lg-4 o_light_label"/>
                        <field name="mrj_meta_days_back" class="col-lg-8"/>
                    </div>
                    <div class="row mt-2">
                        <label for="mrj_meta_version" class="col-lg-4 o_light_label"/>
                        <field name="mrj_meta_version" class="col-lg-8"/>
                    </div>
                    <div class="mt-3 text-muted">Real time (optional): add this URL as a Page webhook for the leadgen field in your Meta app.</div>
                    <div class="row mt-2">
                        <label for="mrj_meta_webhook_url" class="col-lg-4 o_light_label"/>
                        <field name="mrj_meta_webhook_url" class="col-lg-8" readonly="1" widget="CopyClipboardChar"/>
                    </div>
                    <div class="row mt-2">
                        <label for="mrj_meta_verify_token" class="col-lg-4 o_light_label"/>
                        <field name="mrj_meta_verify_token" class="col-lg-8" placeholder="Any secret word; type the same in Meta"/>
                    </div>
                    <div class="row mt-2">
                        <label for="mrj_meta_app_secret" class="col-lg-4 o_light_label"/>
                        <field name="mrj_meta_app_secret" password="True" class="col-lg-8"
                               placeholder="Meta app, App settings, Basic"/>
                    </div>
                    <div class="row mt-2">
                        <label for="mrj_meta_last_result" class="col-lg-4 o_light_label"/>
                        <field name="mrj_meta_last_result" class="col-lg-8" readonly="1"/>
                    </div>
                    <div class="mt-2">
                        <button name="action_mrj_meta_load_forms" type="object" string="Load forms from the Page" class="btn-link" icon="fa-download"/>
                        <button name="action_mrj_meta_sync_now" type="object" string="Import leads now" class="btn-link" icon="fa-refresh"/>
                        <button name="%(mrj_meta_lead_form_action)d" type="action" string="Forms" class="btn-link" icon="fa-arrow-right"/>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
